{
  "root": "Answer",
  "components": {
    "Answer": {
      "signature": "Answer(blocks: (SkillMap | ConceptCard | ComparisonTable | StepWalkthrough | ConceptGraph | Chart | BookList | QuizCheck)[])",
      "description": "Root of every program: the visual blocks that accompany the written answer, in reading order."
    },
    "SkillMap": {
      "signature": "SkillMap(topic: string, skills: {name: string, level: number, status?: \"focus\" | \"done\" | \"review\", note?: string}[], focus?: string, book?: string)",
      "description": "Socratic tutoring: a mastery map of 4-8 subskills for one topic. Use in tutor mode and for \"show progress\"."
    },
    "ConceptCard": {
      "signature": "ConceptCard(title: string, intuition?: string, formal?: string, example?: string, takeaways?: string[], subtitle?: string, book?: string)",
      "description": "Explain one concept or section: intuition, formal statement, worked example, takeaways. Use for \"explain...\" and \"what is...\" questions."
    },
    "ComparisonTable": {
      "signature": "ComparisonTable(columns: string[], rows: (string | number)[][], title?: string, verdict?: string)",
      "description": "Side-by-side comparison or trade-offs. Every row has one cell per column."
    },
    "StepWalkthrough": {
      "signature": "StepWalkthrough(title: string, steps: {title: string, detail: string, formula?: string, cite?: string}[])",
      "description": "Ordered derivation or algorithm walkthrough with at least two steps. Use for \"derive...\", \"walk me through...\"."
    },
    "ConceptGraph": {
      "signature": "ConceptGraph(title: string, nodes: {id: string, label: string, group?: string, detail?: string, cite?: string}[], edges: {from: string, to: string, label?: string}[], subtitle?: string, book?: string)",
      "description": "Architecture or concept relationships as a node-link diagram with a clickable inspector. Use for \"map the architecture...\", \"how do X, Y, Z connect\"."
    },
    "Chart": {
      "signature": "Chart(title: string, items: {label: string, value: number, displayValue?: string, note?: string}[], unit?: string, caption?: string, subtitle?: string, book?: string)",
      "description": "Horizontal bar comparison of one metric across items (benchmarks, scores). Use for \"benchmark...\", \"plot...\"."
    },
    "BookList": {
      "signature": "BookList(books: {book: string, why: string, title?: string, category?: string, start?: string}[], title?: string)",
      "description": "Reading recommendations from the library. Use for \"recommend books...\", \"which books cover...\"."
    },
    "QuizCheck": {
      "signature": "QuizCheck(question: string, options?: string[], hint?: string)",
      "description": "A short check question with optional answer choices and a hint. Clicking a choice sends it as the reply."
    }
  },
