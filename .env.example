BOOKS_DIR=$HOME/Documents/Books
BOOK_READER_PORT=8000
# Extra Host headers to accept (comma list; a leading dot matches subdomains). Needed behind a
# tunnel such as ngrok, e.g. localhost,127.0.0.1,::1,.ngrok-free.app. See `just share`.
# BOOK_READER_ALLOWED_HOSTS=

# Chat providers (OpenAI-compatible). Keys may also be supplied as MISTRAL_API.
MISTRAL_API_KEY=
INCEPTION_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_KEY=
GEMINI_API_KEY=              # or GEMINI_API / GOOGLE_API_KEY
BOOK_READER_CHAT_PRIORITY=inception:mercury-3,gemini:gemini-3.8-flash,mistral:mistral-small-latest,mistral:ministral-8b-latest,mistral:zai-glm-5-3-flash,openrouter:openrouter/free,openrouter:nvidia/nemotron-3-ultra-550b-a55b:free,ollama:gpt-oss:20b

# Zotero data directory holding zotero.sqlite (read-only). Defaults to ~/Zotero; empty disables.
# BOOK_READER_ZOTERO_DIR=

# Contact address sent to Unpaywall so DOI import can find open-access copies. Off when unset.
# BOOK_READER_UNPAYWALL_EMAIL=

# Format the chat model uses for visual blocks: json (default) or lang (OpenUI Lang, opt-in;
# smaller models often write named instead of positional arguments, see ADR-008).
# BOOK_READER_OPENUI_FORMAT=json
