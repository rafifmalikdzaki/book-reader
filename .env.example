BOOKS_DIR=$HOME/Documents/Books
BOOK_READER_PORT=8000

# Chat providers (OpenAI-compatible). Keys may also be supplied as MISTRAL_API.
MISTRAL_API_KEY=
INCEPTION_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_KEY=
BOOK_READER_CHAT_PRIORITY=inception:mercury-3,mistral:mistral-small-latest,mistral:ministral-8b-latest,mistral:zai-glm-5-3-flash,openrouter:openrouter/free,openrouter:nvidia/nemotron-3-ultra-550b-a55b:free,ollama:gpt-oss:20b

# Format the chat model uses for visual blocks: lang (OpenUI Lang, default) or json (legacy).
# BOOK_READER_OPENUI_FORMAT=lang
